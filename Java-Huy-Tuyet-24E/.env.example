# =====================================================================
# File Mẫu Biến Môi Trường Backend (Spring Boot + MySQL)
# Các giá trị mặc định đã được cấu hình sẵn trong src/main/resources/application.yaml.
# - Nếu dùng XAMPP (mật khẩu root để trống): đặt DB_PASSWORD= (để trống)
# - Nếu dùng Docker / MySQL Server (root/root): chạy trực tiếp không cần sửa
# =====================================================================

# Kết nối cơ sở dữ liệu MySQL
DB_URL=jdbc:mysql://localhost:3306/java_booking_nail?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=root

# Địa chỉ Frontend cho phép kết nối CORS
FRONTEND_URL=http://localhost:3000

# Tự động khởi tạo dữ liệu mẫu và tài khoản mẫu khi chạy (true / false)
SEED_DATA_ENABLED=true

# Thư mục lưu trữ ảnh đại diện tải lên
AVATAR_UPLOAD_DIR=./uploads/avatars

# Bảo mật Cookie phiên đăng nhập (chỉ đặt true khi chạy HTTPS)
SESSION_COOKIE_SECURE=false
